# Optional local port
GOZ_IHALE_PORT=8000

# Enable only sources that have been reviewed and configured.
# GOZ_IHALE_ENABLED_SOURCE_KEYS=khgm_central_notices
# GOZ_IHALE_HTML_SOURCE_KEYS=khgm_central_notices
# The registered source URL is used by default; override if needed.
# GOZ_IHALE_HTML_PAGE_KHGM_CENTRAL_NOTICES=https://khgm.saglik.gov.tr/TR-119527/ihale-duyurulari.html

# Never commit secrets or deploy these placeholders.
# GOZ_IHALE_API_WRITE_TOKEN=replace-with-a-strong-random-secret
# GOZ_IHALE_CORS_ORIGINS=https://your-app-domain.example
# GOZ_IHALE_DB=/data/gozihale.db
# GOZ_IHALE_INGEST_DB=/data/ingestion.db
# GOZ_IHALE_SCAN_DB=/data/scan_runs.db

# Telegram delivery (configure securely on the VPS; never commit actual values)
# GOZ_IHALE_TELEGRAM_BOT_TOKEN=replace-with-bot-token
# GOZ_IHALE_TELEGRAM_CHAT_ID=replace-with-chat-id
